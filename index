<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Uji Siaga TKA: Pemahaman Tekstual</title>
    <style>
        /* Menghilangkan margin dan membuat iframe memenuhi seluruh layar */
        body, html {
            margin: 0;
            padding: 0;
            height: 100%;
            overflow: hidden;
            background-color: #f9fafb; /* Sesuai dengan warna background aplikasi */
        }
        iframe {
            width: 100%;
            height: 100%;
            border: none;
            display: block;
        }
        /* Tampilan loading sederhana sebelum iframe termuat */
        #loading-screen {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            font-family: sans-serif;
            color: #4b5563;
            z-index: -1;
        }
    </style>
</head>
<body>

    <div id="loading-screen">Memuat aplikasi...</div>
    
    <!-- Iframe untuk menampilkan Web App Google Apps Script -->
    <iframe id="app-frame" allow="fullscreen"></iframe>

    <script>
        // 1. GANTI URL DI BAWAH INI DENGAN URL /exec MILIK ANDA
        const gasWebAppUrl = "https://script.google.com/macros/s/AKfycbxUrW3ZbH1bYHvCTYw0-Dj8g_a_4WtguZygYHNWKvY-mo7C6-6meyKoC7yCfsTkuKIBCw/exec";

        // 2. Menangkap parameter dari URL (berguna untuk Google Classroom)
        const urlParams = window.location.search;

        // 3. Menggabungkan URL GAS dengan parameter dan memasukkannya ke iframe
        document.getElementById('app-frame').src = gasWebAppUrl + urlParams;
    </script>

</body>
</html>
